// Задача 1: Подсчет уникальных слов
let string1 = "apple Orange pineapple PEAR"
let string2 = "apple aPPle appLe Apple"

func uniqueWordsCount(_ text: String) -> Int {
    let words = text.lowercased().split(separator: " ")
    return Set(words).count
}

print(uniqueWordsCount(string1)) // Output: 4
print(uniqueWordsCount(string2)) // Output: 1

// Задача 2: Проверка корректности скобочной последовательности
func isValidBrackets(_ s: String) -> String {
    var count = 0
    for char in s {
        if char == "(" {
            count += 1
        } else {
            count -= 1
        }
        if count < 0 { return "Некорректная" }
    }
    return count == 0 ? "Корректная" : "Некорректная"
}

print(isValidBrackets("(())"))  // Output: Корректная
print(isValidBrackets("))(("))  // Output: Некорректная
print(isValidBrackets("()()()")) // Output: Корректная

// Задача 3: Группировка строк по длине
let array1 = ["a", "bb", "b", "cccc"]
let array2 = ["a", "b", "c"]

func groupByLength(_ array: [String]) -> [Int: [String]] {
    return Dictionary(grouping: array, by: { $0.count })
}

print(groupByLength(array1)) // Output: [1: ["a", "b"], 2: ["bb"], 4: ["cccc"]]
print(groupByLength(array2)) // Output: [1: ["a", "b", "c"]]

// Задача 4: Средняя оценка
let dict1: [String: Int?] = ["A": 4, "B": 4, "C": 4]
let dict2: [String: Int?] = ["A": nil, "B": nil, "C": nil]

func averageGrade(_ dict: [String: Int?]) -> String {
    let grades = dict.values.compactMap { $0 }
    return grades.isEmpty ? "Никто не сдал" : String(grades.reduce(0, +) / grades.count)
}

print(averageGrade(dict1)) // Output: 4
print(averageGrade(dict2)) // Output: Никто не сдал

// Задача 5: Перечисление математических операций
enum MathOperation {
    case sum(Int, Int)
    case subtract(Int, Int)
    case multiply(Int, Int)
    case divide(Int, Int)
    case square(Int)
    case sqrt(Double)
    
    func compute() -> String {
        switch self {
        case .sum(let a, let b): return "Сумма - \(a + b)"
        case .subtract(let a, let b): return "Разность - \(a - b)"
        case .multiply(let a, let b): return "Произведение - \(a * b)"
        case .divide(let a, let b): return b != 0 ? "Деление - \(a / b)" : "Ошибка: деление на ноль"
        case .square(let a): return "Квадрат - \(a * a)"
        case .sqrt(let a): return a >= 0 ? "Квадратный корень - \(a.squareRoot())" : "Ошибка: отрицательное число"
        }
    }
}

let operations: [MathOperation] = [
    .sum(1, 2),
    .square(2),
    .multiply(3, 3),
    .divide(10, 2),
    .sqrt(16)
]

for operation in operations {
    print(operation.compute())
}